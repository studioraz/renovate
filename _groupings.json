{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Group Amasty Free Gift Pro and its directly required companion modules.",
      "matchPackageNames": [
        "amasty/module-free-gift-subscription-package-pro",
        "amasty/module-free-gift-hyva",
        "amasty/module-free-gift-extended-view",
        "amasty/module-free-gift-header-icon",
        "amasty/module-free-gift-timer",
        "amasty/module-free-bar-promo",
        "amasty/module-auto-add-promo-items-graphql"
      ],
      "groupName": "Amasty Free Gift Pro Modules",
      "enabled": true
    },
    {
      "description": "Group Mirasvit SEO and its Hyva compat module",
      "matchPackageNames": [
        "mirasvit/module-seo",
        "mirasvit/module-seo-hyva"
      ],
      "groupName": "Mirasvit SEO Modules"
    },
    {
      "description": "Group Mirasvit Blog MX and its Hyva compat module",
      "matchPackageNames": [
        "mirasvit/module-blog-mx",
        "mirasvit/module-blog-mx-hyva"
      ],
      "groupName": "Mirasvit Blog MX Modules"
    },
    {
      "description": "Group Mirasvit Catalog Label and its Hyva compat module",
      "matchPackageNames": [
        "mirasvit/module-cataloglabel",
        "mirasvit/module-cataloglabel-hyva"
      ],
      "groupName": "Mirasvit Catalog Label Modules"
    },
    {
      "description": "Group Mirasvit FB Marketing and its Hyva compat module",
      "matchPackageNames": [
        "mirasvit/module-fb-marketing",
        "mirasvit/module-fb-marketing-hyva"
      ],
      "groupName": "Mirasvit FB Marketing Modules"
    },
    {
      "description": "Group Mirasvit Form Builder and its Hyva compat module",
      "matchPackageNames": [
        "mirasvit/module-form-builder",
        "mirasvit/module-form-builder-hyva"
      ],
      "groupName": "Mirasvit Form Builder Modules"
    },
    {
      "description": "Group Mirasvit GTM and its Hyva compat module",
      "matchPackageNames": [
        "mirasvit/module-gtm",
        "mirasvit/module-gtm-hyva"
      ],
      "groupName": "Mirasvit GTM Modules"
    },
    {
      "description": "Group Mirasvit Navigation and its Hyva compat module",
      "matchPackageNames": [
        "mirasvit/module-navigation",
        "mirasvit/module-navigation-hyva"
      ],
      "groupName": "Mirasvit Navigation Modules"
    },
    {
      "description": "Group Mirasvit Search Ultimate and its Hyva compat module",
      "matchPackageNames": [
        "mirasvit/module-search-ultimate",
        "mirasvit/module-search-ultimate-hyva"
      ],
      "groupName": "Mirasvit Search Ultimate Modules"
    },
    {
      "description": "Group Mirasvit Related and its Hyva compat module",
      "matchPackageNames": [
        "mirasvit/module-related",
        "mirasvit/module-related-hyva"
      ],
      "groupName": "Mirasvit Related Modules"
    },
    {
      "description": "Group MageWorx Gift Card base and Hyvä compat modules together",
      "matchPackageNames": [
        "mageworx/module-giftcards",
        "hyva-themes/magento2-mageworx-giftcards"
      ],
      "groupName": "MageWorx Gift Card Modules"
    }
  ]
}
